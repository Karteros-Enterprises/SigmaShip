# Safe-to-expose Supabase browser configuration.
# Copy this file to .env locally and fill in your own project values.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Never commit service-role keys, OAuth client secrets, carrier credentials,
# Stripe secret keys or marketplace access/refresh tokens.

# Stallion v5 integration. Keep tokens server-side in Vercel environment variables.
# Sandbox is the default. Production must be enabled deliberately after approval.
STALLION_BASE_URL=https://sandbox.stallion.ca/api/v5
STALLION_TOKEN=

# Keep disabled until verified sandbox label and persistence flow.
STALLION_WRITES_ENABLED=false
STALLION_LIVE_WRITES_ENABLED=false
